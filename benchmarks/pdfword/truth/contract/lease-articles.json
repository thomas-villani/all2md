   {
    "text": "Rent",
    "style": "Heading 1",
    "level": 1,
    "marker": "Article 2.",
    "list_level": 1
   },
   {
    "text": "Tenant shall pay Base Rent in advance on the first day of each month, without demand, deduction or set-off.",
    "style": "Normal",
    "level": null,
    "marker": null,
    "list_level": null
   },
   {
    "text": "If Rent is more than five days late, Tenant shall pay a late charge of five percent of the overdue amount.",
    "style": "Normal",
    "level": null,
    "marker": null,
    "list_level": null
   },
   {
    "text": "Use of Premises",
    "style": "Heading 1",
    "level": 1,
    "marker": "Article 3.",
    "list_level": 1
   },
   {
    "text": "Tenant shall use the Premises only for general office and design studio purposes, and shall comply with all laws that apply to its use.",
    "style": "Normal",
    "level": null,
    "marker": null,
    "list_level": null
   },
   {
    "text": "Maintenance",
    "style": "Heading 1",
    "level": 1,
    "marker": "Article 4.",
    "list_level": 1
   },
   {
    "text": "Landlord shall keep the roof, structure and common areas in good repair. Tenant shall keep the interior of the Premises clean and in good condition.",
    "style": "Normal",
    "level": null,
    "marker": null,
    "list_level": null
   },
