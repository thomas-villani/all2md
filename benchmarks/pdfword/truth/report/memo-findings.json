   {
    "text": "Recommendations",
    "style": "Heading 1",
    "level": 1,
    "marker": null,
    "list_level": null
   },
   {
    "text": "Merge duplicate vendor records and block new duplicates at entry.",
    "style": "List Paragraph",
    "level": null,
    "marker": "1.",
    "list_level": 1
   },
   {
    "text": "Enforce approval limits in the workflow system by December 31.",
    "style": "List Paragraph",
    "level": null,
    "marker": "2.",
    "list_level": 1
   },
   {
    "text": "Appoint second reviewers at Dundee and Swansea within thirty days.",
    "style": "List Paragraph",
