{
  "family": "fields",
  "description": "Raw field codes as Word writes them: a HYPERLINK field and a REF field pointing at a bookmark, both as fldChar/instrText rather than as elements the parser recognises.",
  "steps": [
    {
      "kind": "wl",
      "args": [
        "insert-markdown",
        "--anchor-id",
        "start",
        "--markdown",
        "-"
      ],
      "stdin": "# Field Codes\n\nIntro paragraph.\n\nField link lives here.\n\nRef target text.\n\nRef pointer here.\n\nTrailing paragraph.\n"
    },
    {
      "kind": "ops",
      "label": "raw field codes",
      "ops": [
        {
          "op": "add_bookmark",
          "name": "RefTarget",
          "anchor_id": "para:4"
        },
        {
          "op": "insert_field",
          "anchor_id": "para:5",
          "kind": "field",
          "text": "REF RefTarget \\h"
        },
        {
          "op": "insert_field",
          "anchor_id": "para:3",
          "kind": "field",
          "text": "HYPERLINK \"https://example.com/target\""
        }
      ]
    }
  ],
  "verify": [
    {
      "part": "word/document.xml",
      "pattern": "HYPERLINK",
      "min": 1
    },
    {
      "part": "word/document.xml",
      "pattern": "REF RefTarget",
      "min": 1
    },
    {
      "part": "word/document.xml",
      "pattern": "<w:fldChar",
      "min": 6
    },
    {
      "part": "word/document.xml",
      "pattern": "<w:bookmarkStart",
      "min": 1
    },
    {
      "part": "word/document.xml",
      "pattern": "<w:hyperlink",
      "min": 0,
      "max": 0
    }
  ],
  "facts": {
    "fields": [
      {
        "field_type": "HYPERLINK",
        "resolved_target": "https://example.com/target",
        "encoding": "fldChar",
        "host_text": "Field link lives here."
      },
      {
        "field_type": "REF",
        "instruction": "REF RefTarget \\h",
        "cached_result": "Ref target text.",
        "encoding": "fldChar"
      }
    ],
    "bookmarks": [
      {
        "name": "RefTarget",
        "covers_text": "Ref target text."
      }
    ]
  }
}
