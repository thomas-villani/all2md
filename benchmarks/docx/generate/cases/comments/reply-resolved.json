{
  "description": "A review thread: a comment with a reply, and a second comment marked resolved. Threading and resolved state live in commentsExtended.xml, not in comments.xml.",
  "steps": [
    {
      "kind": "wl",
      "args": ["insert-markdown", "--anchor-id", "start", "--markdown", "-"],
      "stdin": "# Review Thread\n\nThe first commented sentence.\n\nThe second commented sentence.\n\nAn uncommented closing paragraph.\n"
    },
    {
      "kind": "find_wl",
      "find": "second commented sentence",
      "args": ["comment", "add", "--anchor-id", "{anchor}", "--text", "Fixed in the draft."]
    },
    {
      "kind": "find_wl",
      "find": "first commented sentence",
      "args": ["comment", "add", "--anchor-id", "{anchor}", "--text", "Please reword this."]
    },
    {"kind": "wl", "args": ["comment", "resolve", "--index", "2"]},
    {"kind": "comment_reply", "index": 1, "text": "Agreed, rewording now."}
  ],
  "verify": [
    {"part": "word/comments.xml", "pattern": "<w:comment ", "min": 3, "max": 3},
    {"part": "word/commentsExtended.xml", "pattern": "w15:paraIdParent=", "min": 1, "max": 1},
    {"part": "word/commentsExtended.xml", "pattern": "w15:done=\"1\"", "min": 1, "max": 1}
  ],
  "facts": {
    "body": ["The first commented sentence.", "The second commented sentence."],
    "comments": [
      {"text": "Please reword this.", "anchored_text": "first commented sentence", "reply_to": null, "resolved": false},
      {"text": "Agreed, rewording now.", "reply_to": 0, "resolved": false},
      {"text": "Fixed in the draft.", "anchored_text": "second commented sentence", "reply_to": null, "resolved": true}
    ]
  },
  "family": "comments",
  "control": false
}
