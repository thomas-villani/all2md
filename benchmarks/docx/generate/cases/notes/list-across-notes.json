{
  "description": "Two footnotes, each a lead paragraph and a numbered list on ONE list template, the second continuing the first: Word prints 1. 2. in the first note and 3. 4. in the second. The first note's lead also carries a bold word.",
  "steps": [
    {
      "kind": "wl",
      "args": ["insert-markdown", "--anchor-id", "start", "--markdown", "-"],
      "stdin": "# Note Lists\n\nFirst host sentence.\n\nSecond host sentence.\n\nSpare paragraph.\n"
    },
    {
      "kind": "find_wl",
      "find": "Second host sentence.",
      "args": ["insert-footnote", "--anchor-id", "{anchor}", "--text", "placeholder"]
    },
    {
      "kind": "find_wl",
      "find": "First host sentence.",
      "args": ["insert-footnote", "--anchor-id", "{anchor}", "--text", "placeholder"]
    },
    {
      "kind": "note_list",
      "note": 1,
      "lead": "Steps with a bold word:",
      "items": ["First note step", "Second note step"],
      "bold": "bold",
      "expect": ["1.", "2."]
    },
    {
      "kind": "note_list",
      "note": 2,
      "lead": "More steps:",
      "items": ["Third note step", "Fourth note step"],
      "continue": true,
      "expect": ["3.", "4."]
    }
  ],
  "verify": [
    {"part": "word/document.xml", "pattern": "<w:footnoteReference ", "min": 2, "max": 2},
    {"part": "word/footnotes.xml", "pattern": "placeholder", "min": 0, "max": 0},
    {"part": "word/footnotes.xml", "pattern": "<w:numId w:val=\"(\\d+)\"/>(?:.*?<w:numId w:val=\"\\1\"/>){3}", "min": 1, "max": 1},
    {"part": "word/footnotes.xml", "pattern": "<w:b/>", "min": 1}
  ],
  "facts": {
    "notes": [
      {
        "type": "footnote",
        "text": "Steps with a bold word:",
        "bold": "bold",
        "list": [["1.", "First note step"], ["2.", "Second note step"]]
      },
      {
        "type": "footnote",
        "text": "More steps:",
        "list": [["3.", "Third note step"], ["4.", "Fourth note step"]]
      }
    ]
  },
  "family": "notes",
  "control": false
}
