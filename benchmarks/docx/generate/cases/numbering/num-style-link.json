{
  "description": "A list style: the paragraphs carry w:numPr directly, but the abstractNum it names holds no levels at all -- only a w:numStyleLink back to the style, whose own numbering points at the abstract that has them.",
  "steps": [
    {
      "kind": "wl",
      "args": [
        "insert-markdown",
        "--anchor-id",
        "start",
        "--markdown",
        "-"
      ],
      "stdin": "# List Style Numbering\n\nIntro paragraph.\n\nAlpha item\n\nBeta item\n\nGamma item\n"
    },
    {
      "kind": "list_style_add",
      "name": "CorpNumList",
      "first": 3,
      "last": 5,
      "number_style": 0,
      "format": "%1.",
      "start": 1
    }
  ],
  "verify": [
    {
      "part": "word/numbering.xml",
      "pattern": "<w:numStyleLink w:val=\"CorpNumList\"",
      "min": 1
    },
    {
      "part": "word/numbering.xml",
      "pattern": "<w:styleLink w:val=\"CorpNumList\"",
      "min": 1
    },
    {
      "part": "word/styles.xml",
      "pattern": "w:type=\"numbering\"",
      "min": 1
    },
    {
      "part": "word/document.xml",
      "pattern": "<w:numId w:val=\"[0-9]+\"/>",
      "min": 3
    }
  ],
  "facts": {
    "list": {
      "ordered": true,
      "numfmt": "decimal",
      "start": 1,
      "numpr_on": "paragraph",
      "defined_via": "numStyleLink",
      "items": [
        "Alpha item",
        "Beta item",
        "Gamma item"
      ]
    }
  },
  "family": "numbering",
  "control": false
}
