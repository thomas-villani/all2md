{
  "description": "A standalone display equation. Word writes a bare m:oMath as a direct child of w:p -- not m:oMathPara, and not inside a run -- which falls between both of the parser's extraction paths (#481).",
  "steps": [
    {
      "kind": "wl",
      "args": [
        "insert-markdown",
        "--anchor-id",
        "start",
        "--markdown",
        "-"
      ],
      "stdin": "# Equation\n\nEquation lives below.\n"
    },
    {
      "kind": "wl",
      "args": [
        "insert-equation",
        "--anchor-id",
        "para:2",
        "--unicodemath",
        "x=(-b±√(b^2-4ac))/(2a)",
        "--display"
      ]
    }
  ],
  "verify": [
    {
      "part": "word/document.xml",
      "pattern": "<m:oMath",
      "min": 1
    }
  ],
  "facts": {
    "math": {
      "unicodemath": "x=(-b±√(b^2-4ac))/(2a)",
      "encoding": "bare m:oMath child of w:p",
      "oMathPara": false,
      "note": "wordlive writes m:oMath, never m:oMathPara; see benchmarks/docx/README.md"
    }
  },
  "family": "baseline"
}
